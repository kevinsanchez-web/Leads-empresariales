# Modo "emuladores locales" (es el modo de `npm run dev`; el proyecto real queda en `npm run dev:real`)
# Auth y Firestore apuntan a los emuladores (npm run emulators); no se toca el proyecto real.
VITE_USE_EMULATORS=true

# El Worker de IA publicado solo acepta tokens firmados por Google, y los del emulador de Auth no
# lo están. Vacío = las funciones de IA devuelven datos de ejemplo marcados como simulados.
VITE_AI_WORKER_URL=
